# Kopie als .env.local anlegen und ausfuellen. Niemals committen.

# --- Pflicht fuer die Ortssuche ------------------------------------------
# Google Cloud API Key mit aktivierten APIs "Places API" und "Geocoding API".
# Bewusst OHNE NEXT_PUBLIC_-Praefix: Der Key darf nicht im Browser-Bundle
# landen, alle Aufrufe laufen serverseitig ueber /api/geocode.
# In der Google Cloud Console zusaetzlich einschraenken:
#   - API restrictions: nur Places API + Geocoding API
#   - Application restrictions: IP-Adressen bzw. keine, da serverseitig
#   - Budget-Alarm im Billing-Konto setzen
GOOGLE_MAPS_API_KEY=

# --- Optional: Domain ----------------------------------------------------
# Basis-URL fuer Canonical-Links, Sitemap und robots.txt. Ohne abschliessenden
# Schraegstrich. Lokal weglassen, in Vercel auf die Produktionsdomain setzen.
NEXT_PUBLIC_SITE_URL=https://sporthitzecheck.de

# --- Optional: Fehler-Monitoring (Sentry) --------------------------------
# Ohne diese Werte laeuft die App normal, es werden nur keine Fehler gemeldet.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# Nur fuer Source-Map-Upload beim Build (CI/Vercel), nicht lokal noetig.
SENTRY_AUTH_TOKEN=

# --- Optional: Besucherzaehlung (Zaehlstandard, proxy.ts) -----------------
# Seitenabrufe werden serverseitig an den Zaehldienst auf dem ehrenwert.app-
# Server gemeldet. Ohne diese Werte (lokal, Vorschau) wird nicht gezaehlt.
# Token: auf dem Server "python3 -m stats token" (docs/besucherzahlen.md 5a).
STATS_INGEST_URL=https://ehrenwert.app/stats/annahme
STATS_INGEST_TOKEN=
